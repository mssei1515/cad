{
  "name": "jot2d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "node tools/write-runtime-version.js && node tools/serve.js",
    "write:runtime-version": "node tools/write-runtime-version.js",
    "check": "node tools/check-syntax.js",
    "test:unit": "node tools/run-unit-tests.js",
